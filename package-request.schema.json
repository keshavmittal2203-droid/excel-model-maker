{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package Build Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "workbook"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ticker",
        "valuation_date",
        "historical_cutoff",
        "currency",
        "reporting_unit",
        "fiscal_year_convention"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "minLength": 1 },
        "exchange": { "type": "string" },
        "bse_code": { "type": "string" },
        "valuation_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "historical_cutoff": { "type": "string" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP"] },
        "reporting_unit": { "type": "string", "enum": ["INR_Cr", "INR_Lakh", "USD_M", "USD_B"] },
        "fiscal_year_convention": { "type": "string", "enum": ["April-March", "January-December"] },
        "source_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "type", "period"],
            "properties": {
              "title": { "type": "string" },
              "type": { "type": "string" },
              "period": { "type": "string" },
              "basis": { "type": "string", "enum": ["consolidated", "standalone"] },
              "url_or_path": { "type": "string" }
            }
          }
        },
        "source_data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_supplied_facts": { "type": "object" },
            "source_extracted_facts": { "type": "object" },
            "analyst_assumptions": { "type": "object" },
            "calculated_outputs": { "type": "object" },
            "unresolved_inputs": { "type": "object" }
          }
        },
        "forecast_assumptions": {
          "type": "object"
        }
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_sha256", "model_pack", "output_name"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model_pack": { "type": "string", "minLength": 1 },
        "inputs": { "type": "string", "minLength": 1 },
        "output_name": { "type": "string", "minLength": 1 },
        "expected_recalculated_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidate_source": { "type": "string" },
        "adapter": { "type": "string" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_sheet_pdfs": { "type": "boolean" },
        "pdf_sheets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pdf_orientation": { "enum": ["portrait", "landscape"] },
        "pdf_fit_to_page_wide": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
