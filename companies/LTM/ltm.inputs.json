    "slide1_company_intro": {
      "value": "LTIMindtree Limited (NSE: LTIM | BSE: 540005), a subsidiary of Larsen & Toubro Limited, is a global technology consulting and digital solutions company formed via the November 2022 amalgamation of L&T Infotech (LTI) and Mindtree. It employs 84,307 professionals serving 700+ global clients.",
      "source": "LTIMindtree Limited FY25 Annual Report"
    },
    "slide1_brand_portfolio": {
      "value": "Core digital platforms include Canvas.ai (enterprise GenAI platform), Fosfor (data-to-decisions product suite), Infinity (cloud & infrastructure platform), and BlueVerse ecosystem across BFSI, Hi-Tech, Manufacturing, and Retail.",
      "source": "LTIMindtree Limited FY25 Annual Report"
    },
    "slide1_business_model": {
      "value": "Time-and-material and fixed-price IT services and digital transformation delivery anchored in North America (~74% of revenue) and Europe (~15%), combining offshore delivery scale in India with nearshore global hubs.",
      "source": "LTIMindtree Limited FY25 Annual Report"
    },
    "slide1_product_ecosystem": {
      "value": "End-to-end capabilities across Cloud & Infrastructure, Data & Analytics, Enterprise ERP Modernization (SAP S/4HANA), Cybersecurity, and AI-led software engineering.",
      "source": "LTIMindtree Limited FY25 Annual Report"
    },
    "slide1_strategic_approach": {
      "value": "Cross-selling combined LTI engineering depth and Mindtree digital experience into Global Fortune 500 accounts, expanding utilization (86.5% in FY25 to 87.5% by FY30E), and maintaining >80% free cash flow conversion.",
      "source": "LTIMindtree Limited FY25 Annual Report"
    },
