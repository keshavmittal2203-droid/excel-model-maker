{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excel-model-maker:model-pack:1",
  "title": "Approved model pack",
  "type": "object",
  "required": ["schema_version", "template_sha256", "approval", "inputs", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "template_sha256": {"$ref": "#/$defs/hash"},
    "approval": {
      "type": "object",
      "required": ["reviewer", "approved_at", "template_sha256"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "template_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "sheet", "cell", "kind", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sheet": {"type": "string", "minLength": 1},
          "cell": {"$ref": "#/$defs/cell"},
          "kind": {"const": "number"},
          "unit": {"type": "string", "minLength": 1},
          "period": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "identifier_or_market_snapshot",
              "historical_fact",
              "peer_reference_data",
              "sector_reference_data",
              "valuation_assumption"
            ]
          },
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "description": {"type": "string"},
          "workbook_row_label": {"type": "string"},
          "workbook_column_header": {"type": "string"},
          "audit_flag": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "sheet", "cell", "expected", "abs_tolerance"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sheet": {"type": "string", "minLength": 1},
          "cell": {"$ref": "#/$defs/cell"},
          "expected": {"type": "number"},
          "abs_tolerance": {"type": "number", "minimum": 0},
          "rel_tolerance": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "excluded_schedules": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"}
  }
}
