{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerPoint Deck Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_sha256", "slots"],
  "properties": {
    "schema_version": { "const": 1 },
    "template_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["proposal", "approved"] },
    "proposal_notes": { "type": "string" },
    "retained_slides": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reviewer", "approved_at", "template_sha256"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "template_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slide", "target_type", "shape_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slide": { "type": "integer", "minimum": 1 },
          "target_type": {
            "enum": [
              "shape_text",
              "shape_token",
              "table_cell",
              "picture_replacement",
              "chart_series",
              "chart_data",
              "suppress_shape"
            ]
          },
          "shape_id": { "type": "integer", "minimum": 0 },
          "shape_name": { "type": "string" },
          "paragraph_index": { "type": "integer", "minimum": 0 },
          "token": { "type": "string", "minLength": 1 },
          "row": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "image_asset": { "type": "string" },
          "reason": { "type": "string" },
          "series_index": { "type": "integer", "minimum": 0 },
          "series_name": { "type": "string" },
          "chart_title": { "type": "string" },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" },
          "workbook_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sheet", "cell"],
            "properties": {
              "sheet": { "type": "string", "minLength": 1 },
              "cell": { "type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$" },
              "workbook_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "unit": { "type": "string", "minLength": 1 },
              "period": { "type": "string", "minLength": 1 },
              "scale": { "type": "number" },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
              "thousands_sep": { "type": "boolean" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" },
              "abs_tolerance": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
